# Copy to .env and edit. Never commit .env. Use PayPal SANDBOX credentials only.
APP_ENV=development
# Comma-separated explicit origins (no wildcards). The Next.js dev server runs on :3000.
ALLOWED_ORIGINS=http://localhost:3000
DATABASE_PATH=./data/secondsense.db

# PayPal Sandbox REST app (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Optional: sandbox merchant (payee) account ID. When set, orders are created for and verified against this payee.
# PAYPAL_MERCHANT_ID=

# Friction / lifetime tuning (defaults shown)
# HIGH_RISK_MIN_PAUSE_SECONDS=20
# ACK_VALID_SECONDS=600
# SESSION_TTL_SECONDS=1800
# ORDER_CAPTURE_WINDOW_SECONDS=1800
# REVIEW_TTL_SECONDS=86400
# RATE_LIMIT_PER_MINUTE=30
